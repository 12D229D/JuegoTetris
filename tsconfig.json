{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022","DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "sourceMap": true,
    "jsx": "react",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "types": ["node"]  },
  "include": ["src/**/*","backend/**/*"],
  "exclude": ["node_modules"]
}